{
  "name": "@kagayoi/hatena-blog-mcp",
  "version": "1.0.2",
  "description": "Kagayoi-maintained local stdio MCP server for Hatena Blog and Hatena Fotolife.",
  "license": "MIT",
  "author": "Keisuke Nishitani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1llum1n4t1s/KG.hatena-blog-mcp.git"
  },
  "homepage": "https://github.com/1llum1n4t1s/KG.hatena-blog-mcp#readme",
  "bugs": {
    "url": "https://github.com/1llum1n4t1s/KG.hatena-blog-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hatena-blog",
    "hatena-fotolife",
    "stdio",
    "local",
    "atompub"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hatena-blog-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.en.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm build && node dist/cli.js",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stdio": "pnpm build && node scripts/smoke-stdio.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:stdio",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "fast-xml-parser": "^5.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
